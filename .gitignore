# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
__pycache__/
*.pyc
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!server/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# android/ (ТРЁШКА склад apk-обёртка) — генерируемые Android Studio/Gradle файлы.
# gradlew/gradlew.bat/gradle/wrapper/gradle-wrapper.jar НЕ игнорируются и лежат в
# репозитории: сеть до services.gradle.org/dl.google.com/repo1.maven.org в этой
# песочнице заблокирована (403), поэтому wrapper-jar получен из совместимого
# npm-пакета (bootstrap-код wrapper'а версионно-независим, distributionUrl в
# gradle-wrapper.properties указывает на нужную версию Gradle 8.7). Ниже
# игнорируются только реально генерируемые локальные артефакты сборки/IDE.
android/local.properties
android/.gradle/
android/**/build/
android/*.iml
android/**/*.iml
android/.idea/
android/app/google-services.json
server/secrets/
server/backups/
