POSTGRES_DB=treshka_sklad
POSTGRES_USER=treshka
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DATABASE_URL=postgresql://treshka:CHANGE_ME_LONG_RANDOM@db:5432/treshka_sklad
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
PUBLIC_BASE_URL=https://sklad.example.ru
DOMAIN=sklad.example.ru
MEDIA_ROOT=/data/media
STORAGE_BACKEND=local
# Для будущего переключения без изменения приложения:
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.timeweb.cloud
# S3_BUCKET=treshka-sklad
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# FCM_CREDENTIALS=/run/secrets/firebase-service-account.json
